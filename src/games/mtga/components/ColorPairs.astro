---
/** Colour-pair win rates of one set and format (two-colour decks, with and without a splash). */
import { int, pct } from '../../../core/format.ts';
import type { LimitedRatings } from '../schema.ts';

interface Props {
  ratings: LimitedRatings;
  /** Hide combinations with fewer games. */
  minGames?: number;
  limit?: number;
  compact?: boolean;
}

const { ratings, minGames = 300, limit = 20, compact = false } = Astro.props;
const NAMES: Record<string, string> = {
  WU: 'Azorius', UB: 'Dimir', BR: 'Rakdos', RG: 'Gruul', WG: 'Selesnya', WB: 'Orzhov', UR: 'Izzet', BG: 'Golgari', WR: 'Boros', UG: 'Simic',
};
const COLOR: Record<string, string> = { W: 'White', U: 'Blue', B: 'Black', R: 'Red', G: 'Green' };
const rows = ratings.colorPairs
  .filter((p) => p.colors.length === 2 && p.games >= minGames && p.wr !== null)
  .sort((a, b) => (b.wr ?? 0) - (a.wr ?? 0) || b.games - a.games)
  .slice(0, limit);
const total = ratings.totals.games;
const best = rows[0]?.wr ?? 0.6;
const worst = rows[rows.length - 1]?.wr ?? 0.4;
const span = Math.max(0.01, best - worst);
---

{
  rows.length === 0 ? (
    <p class="muted">Not enough two-colour games to compare colour pairs.</p>
  ) : (
    <div class="tablewrap">
      <table class:list={['mtable', 'cpairs', { 'mtable--compact': compact }]}>
        <caption class="visually-hidden">Win rate by colour pair, best first</caption>
        <thead>
          <tr>
            <th scope="col">Colours</th>
            <th scope="col" class="num">Win rate</th>
            {!compact && <th scope="col" class="num">Games</th>}
            {!compact && <th scope="col" class="num">Share</th>}
          </tr>
        </thead>
        <tbody>
          {rows.map((p) => (
            <tr>
              <th scope="row">
                <span class="pips" aria-hidden="true">
                  {[...p.colors].map((c) => (
                    <span class="pip" data-c={c}>{c}</span>
                  ))}
                </span>
                <span class="cpairs__name">{NAMES[p.colors] ?? p.colors}</span>
                {p.splash && <span class="cpairs__splash">+ splash</span>}
                <span class="visually-hidden"> ({[...p.colors].map((c) => COLOR[c]).join(' and ')})</span>
              </th>
              <td class="num">
                <span class="cpairs__bar" style={`--w: ${Math.round((15 + (85 * ((p.wr ?? 0) - worst)) / span))}%`} aria-hidden="true"></span>
                {pct(p.wr ?? 0)}
              </td>
              {!compact && <td class="num">{int(p.games)}</td>}
              {!compact && <td class="num">{pct(total > 0 ? p.games / total : 0)}</td>}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )
}
