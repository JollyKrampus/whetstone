---
/**
 * The Heroes Profile credit, rendered right next to any statistics (SPEC §1.5 inline rule: same
 * screen, body-size text, working link), plus a plain note when the numbers are a synthetic
 * fixture sample rather than real matches.
 */
import SourceAttribution from '../../../components/SourceAttribution.astro';
import { getStats } from '../load.ts';
import { hpSource } from './pagedata.ts';

interface Props {
  /** What the numbers on this screen are, e.g. "Tier badges use Storm League win rates." */
  lead?: string;
  class?: string;
}

const { lead, class: extra } = Astro.props;
const stats = getStats();
---

{
  stats && (
    <div class:list={['scredit', extra]} data-hp-credit>
      {lead && <p class="scredit__lead">{lead}</p>}
      <SourceAttribution sources={hpSource()} placement="inline" asOf={stats.fetchedAt} />
      {stats.synthetic && (
        <p class="scredit__sample">
          Sample build: these numbers are synthetic fixtures for testing the pages, not real matches.
        </p>
      )}
    </div>
  )
}

<style>
  .scredit {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-2) var(--sp-3);
    border-left: 3px solid var(--info);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--info) 7%, var(--surface));
  }

  .scredit__lead,
  .scredit__sample {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>
