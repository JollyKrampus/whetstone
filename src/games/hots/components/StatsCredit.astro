---
/**
 * The credit for whatever source provided the statistics, rendered right next to them (SPEC §1.5
 * inline rule: same screen, body-size text, working link). The source comes from the statistics
 * file's own `source` id, looked up in the game module's SourceRefs, so no source is hard-coded
 * here. Adds a plain note when the numbers are a synthetic fixture sample rather than real matches.
 */
import SourceAttribution from '../../../components/SourceAttribution.astro';
import { getStats, statsSources } from '../load.ts';

interface Props {
  /** What the numbers on this screen are, e.g. "Tier badges use Storm League win rates." */
  lead?: string;
  class?: string;
}

const { lead, class: extra } = Astro.props;
const stats = getStats();
const sources = statsSources();
---

{
  stats && (
    <div class:list={['scredit', extra]} data-stats-credit>
      {lead && <p class="scredit__lead">{lead}</p>}
      {sources.length > 0 && <SourceAttribution sources={sources} placement="inline" asOf={stats.fetchedAt} />}
      {stats.synthetic && (
        <p class="scredit__sample">
          Sample build: these numbers are synthetic fixtures for testing the pages, not real matches.
        </p>
      )}
    </div>
  )
}

<style>
  .scredit {
    display: grid;
    gap: var(--sp-1);
    padding: var(--sp-2) var(--sp-3);
    border-left: 3px solid var(--info);
    border-radius: var(--radius-sm);
    background: color-mix(in srgb, var(--info) 7%, var(--surface));
  }

  .scredit__lead,
  .scredit__sample {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }
</style>
