---
/**
 * The three matchup lists of a hero page: strong against, weak against, works well with.
 * Statistics rows only make the headline list when they pass the SPEC §6 bar (n and |Δ|);
 * theory rows follow the theory bar (load.ts THEORY_GATES: curated matchups, plus the hero's
 * strongest generic rule matches scoring 65+), curated first, labelled by their source badge.
 * Everything else sits behind a "below the bar" disclosure as a light text list (name, score,
 * source and the main reason): full rows with rings for every opponent made hero pages several
 * hundred kilobytes for lists most visitors never open.
 */
import MatchupList from '../../../components/MatchupList.astro';
import { edgeSourceLabel, type MatchupRow } from '../../../components/types.ts';
import { int, pp } from '../../../core/format.ts';
import { GATES, THEORY_GATES, type HeroMatchupRow } from '../load.ts';
import { toMatchupRow } from '../view.ts';
import { splitByGate, type MatchupLists } from './pagedata.ts';

interface Props {
  heroName: string;
  lists: MatchupLists;
  basis: 'stats' | 'theory';
  sourceNames: Record<string, string>;
  /** Prefix for element ids, unique per rendered block. */
  idPrefix: string;
}

const { heroName, lists, basis, sourceNames, idPrefix } = Astro.props;
const bar = `at least ${GATES.listMinN} games and an edge of ${GATES.listMinDeltaPp} pp`;

const columns = [
  {
    key: 'strong',
    title: `${heroName} is strong against`,
    subtitle:
      basis === 'stats'
        ? `Score 1–100 · Δ = ${heroName}'s edge over the expected result, in pp · n = games`
        : `Score 1–100 for ${heroName}'s net edge once both kits are weighed (50 = neutral)`,
    rows: lists.strong,
    empty: basis === 'stats' ? `No counter clears the bar yet (${bar}).` : `No mechanical edge for ${heroName} found yet.`,
  },
  {
    key: 'weak',
    title: `${heroName} is weak against`,
    subtitle:
      basis === 'stats'
        ? `Score 1–100 · Δ = their edge over ${heroName}, in pp · n = games`
        : `Score 1–100 for their net edge over ${heroName}'s kit`,
    rows: lists.weak,
    empty: basis === 'stats' ? `No threat clears the bar yet (${bar}).` : `No hero has a mechanical edge on ${heroName} in our rules yet.`,
  },
  {
    key: 'synergy',
    title: `${heroName} works well with`,
    subtitle:
      basis === 'stats'
        ? 'Score 1–100 · Δ = gain when on the same team, in pp · n = games'
        : 'Score 1–100 for how well the kits combine',
    rows: lists.synergy,
    empty: basis === 'stats' ? `No partner clears the bar yet (${bar}).` : 'No synergy rule matches yet.',
  },
].map((c) => {
  const { listed, other } = splitByGate<HeroMatchupRow>(c.rows);
  return { ...c, listed: listed.map((r) => toMatchupRow(r)), other: other.map((r) => toMatchupRow(r)) };
});

const belowNote =
  basis === 'stats'
    ? `Fewer than ${GATES.listMinN} games or an edge under ${GATES.listMinDeltaPp} pp; "low sample" marks fewer than ${GATES.greyBelow} games.`
    : `Generic rule matches with no hand-written matchup behind them: scoring under ${THEORY_GATES.listMinScore}, or past the ${THEORY_GATES.listMaxGeneric} strongest.`;

/** One compact line: what the full row shows, minus the ring and the expandable reasons. */
const facts = (r: MatchupRow): string[] => [
  ...(r.delta !== undefined ? [pp(r.delta)] : []),
  ...(r.n !== undefined ? [`n = ${int(r.n)}`] : []),
  r.sourceLabel ?? edgeSourceLabel(r.source),
  ...(r.lowSample ? ['low sample'] : []),
];
---

<div class="ccols" data-basis={basis}>
  {
    columns.map((c) => (
      <div class="ccols__col" data-list={c.key}>
        <MatchupList
          id={`${idPrefix}-${c.key}`}
          title={c.title}
          subtitle={c.subtitle}
          rows={c.listed}
          visible={8}
          sourceNames={sourceNames}
          emptyText={c.empty}
          level={3}
        />
        {c.other.length > 0 && (
          <details class="ccols__below" data-below={c.key}>
            <summary class="btn btn--ghost">{c.other.length} more below the bar</summary>
            <div class="ccols__belowbody">
              <h4 class="ccols__belowtitle">{basis === 'stats' ? 'Below the reliability bar' : 'Weaker mechanical edges'}</h4>
              <p class="ccols__note">{belowNote}</p>
              <ol class="lrows">
                {c.other.map((r) => (
                  <li class="lrow" data-id={r.id} data-low={r.lowSample ? 'true' : undefined}>
                    <span class="lrow__head">
                      {r.href ? <a href={r.href}>{r.name}</a> : <span>{r.name}</span>}
                      <span class="lrow__score">
                        <span class="visually-hidden">Score </span>
                        {Math.round(r.score)}
                      </span>
                      <span class="lrow__facts">{facts(r).join(' · ')}</span>
                    </span>
                    {r.reasons?.[0] && <span class="lrow__why">{r.reasons[0].text}</span>}
                  </li>
                ))}
              </ol>
            </div>
          </details>
        )}
      </div>
    ))
  }
</div>

<style>
  .ccols {
    display: grid;
    gap: var(--sp-6);
  }

  .ccols__col {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
    min-width: 0;
  }

  .ccols__below {
    display: grid;
    gap: var(--sp-3);
  }

  .ccols__below > summary {
    justify-self: start;
    border-color: var(--border);
  }

  .ccols__belowbody {
    display: grid;
    gap: var(--sp-2);
    margin-top: var(--sp-3);
  }

  .ccols__belowtitle {
    font-size: var(--fs-md);
  }

  .ccols__note {
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .lrows {
    display: grid;
    gap: var(--sp-1);
    padding: 0;
    margin: 0;
    list-style: none;
  }

  .lrow {
    display: grid;
    gap: 0.1rem;
    padding: var(--sp-1) 0;
    border-bottom: 1px solid var(--border);
    min-width: 0;
  }

  .lrow__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--sp-1) var(--sp-2);
  }

  .lrow__head > a {
    font-weight: 650;
  }

  .lrow__score {
    font-family: var(--font-mono);
    font-weight: 650;
  }

  .lrow__facts,
  .lrow__why {
    color: var(--text-muted);
    font-size: var(--fs-xs);
  }

  .lrow__why {
    overflow-wrap: anywhere;
  }

  .lrow[data-low] .lrow__head > a {
    opacity: 0.8;
  }

  @media (min-width: 64rem) {
    .ccols {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: var(--sp-5);
    }
  }
</style>
