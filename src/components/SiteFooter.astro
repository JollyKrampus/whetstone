---
import type { GameId } from '../core/game.ts';
import { SITE, gameById, games, listNames, rightsHolders, withBase } from '../games/registry.ts';
import SourceAttribution from './SourceAttribution.astro';

interface Props {
  /** On game pages the footer also carries that game's footer-rule credits. */
  game?: GameId | undefined;
}

const { game } = Astro.props;
const current = game ? gameById(game) : null;
const hasFooterCredits = current?.sources.some((s) => s.rule === 'footer') ?? false;

/*
 * Rights and trademark notices come from each game's registry entry (GamePresentation.legalNotice;
 * wording follows the rights holder's published fan guidance). Every page carries all of them,
 * current game first.
 */
const ordered = game ? [...games.filter((g) => g.id === game), ...games.filter((g) => g.id !== game)] : games;
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    {
      current && hasFooterCredits && (
        <section class="site-footer__credits" aria-labelledby="footer-credits-title">
          <h2 id="footer-credits-title" class="kicker">
            {current.short} data sources
          </h2>
          <SourceAttribution game={current.id} rule="footer" placement="footer" />
        </section>
      )
    }

    <div class="site-footer__grid">
      <section class="site-footer__about" aria-label="About Whetstone">
        <p class="site-footer__brand">{SITE.name}</p>
        <p class="muted">
          A free, ad-free, open-source meta companion. No accounts, no trackers, no paywall. Data is refreshed daily and
          every number shows its source and sample size.
        </p>
        <ul class="site-footer__links">
          <li><a href={withBase('about/')}>About</a></li>
          <li><a href={withBase('credits/')}>Credits</a></li>
          <li><a href={withBase('privacy/')}>Privacy</a></li>
          <li><a href={withBase('terms/')}>Terms</a></li>
          <li><a href={withBase('licenses.txt')}>Software licences</a></li>
          <li><a href={SITE.repo} rel="noopener">Source code</a></li>
          <li><a href={SITE.feedback} rel="noopener">Feedback</a></li>
        </ul>
      </section>

      <section class="site-footer__legal" aria-label="Legal notices">
        <p>
          <strong>Whetstone is an unofficial fan project.</strong> It is not affiliated with, endorsed, sponsored or approved
          by {listNames(rightsHolders(), 'or')}, and is not affiliated with heroescounters.com.
        </p>
        <dl class="site-footer__notices">
          {
            ordered.map((g) => (
              <div class="site-footer__notice" data-game={g.id} data-current={g.id === game ? 'true' : undefined}>
                <dt>{g.legalNotice.heading}</dt>
                <dd>{g.legalNotice.body.map((part) => (typeof part === 'string' ? part : <a href={part.href} rel="noopener">{part.text}</a>))}</dd>
              </div>
            ))
          }
        </dl>
      </section>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--border);
    background:
      repeating-linear-gradient(135deg, var(--hatch) 0 1px, transparent 1px 9px),
      var(--surface);
    color: var(--text-muted);
    font-size: var(--fs-sm);
  }

  .site-footer__inner {
    display: grid;
    gap: var(--sp-6);
    padding-block: var(--sp-6) var(--sp-7);
  }

  .site-footer__credits {
    display: grid;
    gap: var(--sp-2);
    padding-bottom: var(--sp-5);
    border-bottom: 1px solid var(--border);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--sp-6);
  }

  .site-footer__brand {
    color: var(--text);
    font-weight: 800;
    font-size: var(--fs-lg);
    letter-spacing: -0.02em;
  }

  .site-footer__about {
    display: grid;
    gap: var(--sp-3);
    align-content: start;
  }

  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-4);
    padding: 0;
    list-style: none;
  }

  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    color: var(--text);
    font-weight: 600;
  }

  .site-footer__legal {
    display: grid;
    gap: var(--sp-4);
  }

  .site-footer__legal strong {
    color: var(--text);
  }

  .site-footer__notices {
    display: grid;
    gap: var(--sp-3);
  }

  .site-footer__notice {
    padding-left: var(--sp-3);
    border-left: 2px solid var(--border-strong);
  }

  .site-footer__notice[data-current] {
    border-left-color: var(--accent);
  }

  .site-footer__notice dt {
    color: var(--text);
    font-weight: 650;
  }

  .site-footer a {
    color: var(--text);
  }

  @media (min-width: 60rem) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
      gap: var(--sp-7);
    }
  }
</style>
