---
/** Whetstone mark: a faceted stone whose top-left facet is the honed edge. Original artwork. */
interface Props {
  size?: number;
  class?: string;
}
const { size = 28, class: extra } = Astro.props;
---

<svg class:list={['brand-mark', extra]} width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path d="M16 2 2 16h14z" class="brand-mark__edge"></path>
  <path d="M16 2 30 16H16z" class="brand-mark__f1"></path>
  <path d="M30 16 16 30V16z" class="brand-mark__f3"></path>
  <path d="M16 30 2 16h14z" class="brand-mark__f2"></path>
</svg>

<style>
  .brand-mark {
    flex: none;
  }
  .brand-mark__edge {
    fill: var(--edge);
  }
  .brand-mark__f1 {
    fill: var(--steel-3);
  }
  .brand-mark__f2 {
    fill: var(--steel-2);
  }
  .brand-mark__f3 {
    fill: var(--steel-1);
  }
</style>
