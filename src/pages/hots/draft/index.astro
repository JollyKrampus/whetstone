---
/**
 * /hots/draft/: Storm League draft helper (SPEC §7). The island gets the roster, map list, free
 * rotation and pro ban rates as props (class A and A-SA, build time) and fetches the staged
 * draft shard for the scoring tables. Match statistics, when a licensed source provides them,
 * arrive only inside that shard's class-B overlay; the island credits whichever source backs
 * the numbers it shows, on the same screen.
 */
import { formatDayUTC } from '../../../core/format.ts';
import { navHref } from '../../../games/registry.ts';
import DraftTool from '../../../games/hots/components/draft/DraftTool.tsx';
import { draftMaps, draftRoster, freeRotation, proPrior, sourceCredits } from '../../../games/hots/components/draft/build.ts';
import GameLayout from '../../../layouts/GameLayout.astro';
import { stagedUrl } from '../../../lib/stagemap.ts';

const shardUrl = stagedUrl('hots', 'draft');
const roster = draftRoster();
const maps = draftMaps();
const rotation = freeRotation(roster);
const credits = sourceCredits();
const pro = proPrior(roster);
const rotationLabel = rotation.window ? `Free this week: ${formatDayUTC(rotation.window.start)} to ${formatDayUTC(rotation.window.end)}` : null;
---

<GameLayout
  game="hots"
  title="Draft helper"
  description="Storm League draft helper for Heroes of the Storm: the real pick and ban order, Cho'gall rules, role checks and explained pick and ban suggestions. Share any draft as a link."
  inlineCredits={false}
>
  <div class="dpage">
    <header class="dpage__head">
      <p class="kicker">Storm League · {roster.length} heroes</p>
      <h1>Draft helper</h1>
      <p class="dpage__lead">
        Follow the real Storm League order step by step: three bans each, picks in 1-2-2-2-2-1, Cho'gall only where a team picks twice in a row. Every
        suggestion says why it ranks where it does and what to watch out for, and the link in your address bar always holds the whole draft.
      </p>
    </header>

    <noscript>
      <p class="dpage__nojs">The draft helper needs JavaScript. The hero and map pages work without it.</p>
    </noscript>

    <DraftTool
      client:load
      shardUrl={shardUrl}
      roster={roster}
      maps={maps}
      free={rotation.ids}
      freeLabel={rotationLabel}
      credits={credits}
      pro={pro}
      poolHref={navHref('hots')}
    />

    <section class="dpage__how" aria-labelledby="draft-how">
      <h2 id="draft-how">How the suggestions work</h2>
      <ul>
        <li>
          <strong>Picks</strong> add up evidence for the team on the clock: counters against heroes already locked by the other side, synergy with
          teammates, fit for the chosen map, and whether the team can still end up with a Healer and a frontline hero. The last pick also checks for
          ranged damage, waveclear and more than one source of hard crowd control, naming the heroes that bring them.
        </li>
        <li>
          <strong>Bans</strong> are ranked as threats: how strong the hero would be for the other side, which of your locked heroes it beats, and how
          many heroes you could still pick it counters (and how hard). Without match statistics, how often pros ban the hero adds a small prior,
          credited next to the list.
        </li>
        <li>
          <strong>Early picks</strong> favour heroes with few hard counters still available to the other side.
        </li>
        <li>
          Without match statistics every signal is <em>theory</em>: rules applied to ability and talent text plus hand-written notes. When statistics
          are available they take over and the source is credited next to them.
        </li>
        <li>
          Each kind of evidence is capped, so piling up counters and synergies never buries a composition problem such as a second Healer late in
          the draft. A reason that needs a talent says so: <em>Only when</em> the hero takes it.
        </li>
        <li>
          Sort modes re-weigh the same signals. Tap <em>Why this score?</em> on any suggestion to see each signal, its weight and what it adds.
        </li>
        <li>
          When both teams are locked, a <strong>draft review</strong> lists the key matchups, the best pair on each side, map fit and any
          composition problems, with a plain-text summary to copy.
        </li>
      </ul>
      <p>
        Free mode works like a team picker: put heroes on either team in any order, and tick <em>Also show suggestions for the other team</em> to
        see both sides at once. Your pool (owned heroes and favourites) is kept in this browser only.
      </p>
    </section>
  </div>
</GameLayout>

<style>
  .dpage {
    display: grid;
    gap: var(--sp-5);
  }

  .dpage__head {
    display: grid;
    gap: var(--sp-2);
  }

  .dpage__lead {
    max-width: 68ch;
    color: var(--text-muted);
  }

  .dpage__nojs {
    padding: var(--sp-3) var(--sp-4);
    border: 1px solid var(--border-strong);
    border-radius: var(--radius);
  }

  .dpage__how {
    display: grid;
    gap: var(--sp-3);
    max-width: 72ch;
    padding-top: var(--sp-5);
    border-top: 1px solid var(--border);
  }

  .dpage__how h2 {
    font-size: var(--fs-xl);
  }

  .dpage__how ul {
    display: grid;
    gap: var(--sp-2);
    padding-left: 1.25rem;
  }

  .dpage__how p,
  .dpage__how li {
    color: var(--text-muted);
  }

  .dpage__how strong,
  .dpage__how em {
    color: var(--text);
  }
</style>
