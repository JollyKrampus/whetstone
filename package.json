{
  "name": "grindstone-mcp",
  "version": "0.2.0",
  "description": "MCP server that validates, rates, and tunes MTG Arena decklists against your wildcard budget.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "grindstone-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "rubric",
    "meta",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.13"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mtg",
    "magic-the-gathering",
    "mtg-arena",
    "scryfall"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.1",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  },
  "exports": {
    ".": "./dist/index.js",
    "./core": {
      "types": "./dist/core.d.ts",
      "import": "./dist/core.js"
    },
    "./rubric/*": "./rubric/*",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "./dist/index.js"
  ]
}
