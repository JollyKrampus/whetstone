{
  "name": "whetstone",
  "version": "0.1.0",
  "private": true,
  "description": "A free, static, multi-game meta companion: Heroes of the Storm counters and draft, MTG Arena deck tools, Pokémon Champions team building. Data refreshed daily.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "imports": {
    "#core/*": "./src/core/*",
    "#games/*": "./src/games/*",
    "#pipeline/*": "./pipeline/*"
  },
  "scripts": {
    "predev": "node pipeline/stage.ts",
    "dev": "astro dev",
    "build": "node pipeline/stage.ts && astro build && node scripts/sw.ts",
    "preview": "astro preview",
    "check": "astro check && tsc -p tsconfig.pipeline.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "data": "node pipeline/run.ts --game all",
    "data:offline": "node pipeline/run.ts --game all --offline",
    "data:pull": "node scripts/data-pull.ts",
    "prepare": "npm run build -w grindstone-mcp"
  },
  "dependencies": {
    "@astrojs/preact": "6.0.6",
    "@astrojs/sitemap": "3.7.4",
    "@preact/signals": "2.11.3",
    "@smogon/calc": "0.12.0",
    "astro": "7.3.8",
    "grindstone-mcp": "^0.3.1",
    "preact": "^10.29.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.19.2",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "fflate": "^0.8.3",
    "globals": "^17.13.0",
    "sharp": "^0.35.5",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3",
    "workbox-build": "^7.4.1"
  },
  "workspaces": [
    "packages/*"
  ]
}
